# Docker Compose injects DB URL in docker-compose.yml (postgres service).
# For local Uvicorn on Windows, use 127.0.0.1, not `postgres`:
# DATABASE_URL=postgresql+psycopg2://bot:bot@127.0.0.1:5432/bot_server

BOT_SERVER_PORT=8000
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
MAIN_BACKEND_URL=http://host.docker.internal:4000
SERVICE_TOKEN=dev-bot-secret-123456789
BOT_JOB_QUEUE=bot_action_queue
BOT_JOB_PAYLOAD_PREFIX=poker_bot_server:job:
LOG_LEVEL=INFO
BOT_LOCK_TTL_SECONDS=15
REQUEST_TIMEOUT_SECONDS=30
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=change-me
DASHBOARD_SESSION_SECRET=change-dashboard-session-secret
